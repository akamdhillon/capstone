# =============================================================================
# Clarity+ Environment Configuration
# =============================================================================

# -- Deployment Targets -------------------------------------------------------
# "mac"   -> Running locally on macOS
# "jetson"-> Running on Jetson Nano
BACKEND_TARGET=mac
JETSON_TARGET=jetson

# -- Network Addresses --------------------------------------------------------
# BACKEND_IP = Mac running backend+frontend, JETSON_IP = Jetson Nano running ML
JETSON_IP=192.168.50.2
BACKEND_IP=192.168.50.1

# -- Frontend -----------------------------------------------------------------
VITE_API_URL=http://192.168.50.1:8000

# -- Feature Toggles ----------------------------------------------------------
THERMAL_ENABLED=false
DEV_MODE=false

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# -- Camera -------------------------------------------------------------------
MAC_CAMERA_INDEX=0
# Jetson stereo cameras (left/right USB indices)
CAMERA_DEVICE_LEFT=2
CAMERA_DEVICE_RIGHT=3

# -- LLM (Voice Assistant) ---------------------------------------------------
# Ollama: localhost when running on same machine; use Jetson IP when Ollama runs on Jetson
OLLAMA_HOST=http://192.168.50.2:11434
# OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MODEL=llama3.2:3b

# -- Security -----------------------------------------------------------------
ENCRYPTION_KEY=clarity_default_key_change_in_prod!

# -- Data Retention -----------------------------------------------------------
IMAGE_RETENTION_DAYS=30
JANITOR_SCHEDULE_HOUR=2

# -- Docker Runtime (not used in local dev) -----------------------------------
DOCKER_RUNTIME=runc
MODEL_PRECISION=FP32

# -- API Keys (ElevenLabs, PicoVoice) ----------------------------------------
ELEVENLABS_API_KEY="sk_fa863622bac803d5936a6661220e8e7c52f24ed1fa68bd8a"
PICOVOICE_ACCESS_KEY="RCJ96vAOSbv6akIy8P2JF5wbk0evbgGt2BBc/uByGp3au8hK9vfDNg=="
BACKEND_URL="http://192.168.50.1:8000/voice/intent"
BACKEND_FACE_URL="http://192.168.50.1:8000/api/face/recognize"
