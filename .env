# =============================================================================
# Clarity+ Environment Configuration
# =============================================================================

# -- Network Addresses --------------------------------------------------------
# Switch by commenting one block and uncommenting the other:

# Mac local (backend, frontend, services all on this machine)
SERVICES_HOST=localhost
RPI_IP=localhost

# Prod (separate services host on network)
# SERVICES_HOST=192.168.2.2
# RPI_IP=192.168.2.1

# -- Frontend -----------------------------------------------------------------
# Mac: localhost. Prod: use RPi IP or localhost if frontend served from RPi
VITE_API_URL=http://localhost:8000

# -- Feature Toggles ----------------------------------------------------------
DEV_MODE=false

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# -- Camera -------------------------------------------------------------------
MAC_CAMERA_INDEX=0

# -- LLM (Voice Assistant) ---------------------------------------------------
# OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MODEL=llama3.2:1b
